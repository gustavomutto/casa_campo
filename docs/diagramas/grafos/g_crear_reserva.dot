leyenda [shape=plaintext, fixedsize=false, style="", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="2" BGCOLOR="#fafafa"><TR><TD COLSPAN="2"><B>Nodos</B></TD></TR><TR><TD ALIGN="RIGHT"><B>1</B></TD><TD ALIGN="LEFT">casa = casas.obtenerPorId(casaId)</TD></TR><TR><TD ALIGN="RIGHT"><B>2a</B></TD><TD ALIGN="LEFT">¿casa == null?</TD></TR><TR><TD ALIGN="RIGHT"><B>2b</B></TD><TD ALIGN="LEFT">¿!casa.activa?</TD></TR><TR><TD ALIGN="RIGHT"><B>3</B></TD><TD ALIGN="LEFT">throw casa no existe o inactiva</TD></TR><TR><TD ALIGN="RIGHT"><B>4</B></TD><TD ALIGN="LEFT">cliente = clientes.obtenerPorId(clienteId)</TD></TR><TR><TD ALIGN="RIGHT"><B>5</B></TD><TD ALIGN="LEFT">¿cliente == null?</TD></TR><TR><TD ALIGN="RIGHT"><B>6</B></TD><TD ALIGN="LEFT">throw cliente no existe</TD></TR><TR><TD ALIGN="RIGHT"><B>7</B></TD><TD ALIGN="LEFT">hoy, entrada, salida = soloFecha(...); ¿entrada &lt; hoy?</TD></TR><TR><TD ALIGN="RIGHT"><B>8</B></TD><TD ALIGN="LEFT">throw fecha de entrada anterior a hoy</TD></TR><TR><TD ALIGN="RIGHT"><B>9</B></TD><TD ALIGN="LEFT">¿salida &lt;= entrada?</TD></TR><TR><TD ALIGN="RIGHT"><B>10</B></TD><TD ALIGN="LEFT">throw fecha de salida inválida</TD></TR><TR><TD ALIGN="RIGHT"><B>11</B></TD><TD ALIGN="LEFT">rango = RangoFechas(...); ¿noches &gt; 30?</TD></TR><TR><TD ALIGN="RIGHT"><B>12</B></TD><TD ALIGN="LEFT">throw estadía mayor a 30 noches</TD></TR><TR><TD ALIGN="RIGHT"><B>13a</B></TD><TD ALIGN="LEFT">¿huéspedes &lt; 1?</TD></TR><TR><TD ALIGN="RIGHT"><B>13b</B></TD><TD ALIGN="LEFT">¿huéspedes &gt; capacidad?</TD></TR><TR><TD ALIGN="RIGHT"><B>14</B></TD><TD ALIGN="LEFT">throw cantidad de huéspedes</TD></TR><TR><TD ALIGN="RIGHT"><B>15</B></TD><TD ALIGN="LEFT">disponible = disponibilidad.estaDisponible(...); ¿!disponible?</TD></TR><TR><TD ALIGN="RIGHT"><B>16</B></TD><TD ALIGN="LEFT">throw casa no disponible</TD></TR><TR><TD ALIGN="RIGHT"><B>17</B></TD><TD ALIGN="LEFT">reserva = Reserva(Pendiente, monto = tarifa.calcular()); guardar; return</TD></TR></TABLE>>];
