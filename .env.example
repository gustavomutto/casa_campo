# ============================================================
#  Casas Campestres — configuración (copia este archivo como .env)
#  En Railway/Render estas variables se ponen en el panel del servicio.
# ============================================================

# URL pública del sitio, sin "/" al final (se usa en correos, Wompi y calendarios iCal)
BASE_URL=https://www.tudominio.co
PORT=3000
NODE_ENV=production

# Carpeta donde se guardan la base de datos y las fotos/videos.
# En Railway monta un "Volume" en /data y deja DATA_DIR=/data (si no, se borra todo en cada despliegue).
DATA_DIR=/data

# Administrador inicial (solo se usa la primera vez que arranca, cuando no hay ningún admin)
ADMIN_USER=admin
ADMIN_PASSWORD=cambia-esta-clave-larga

# ---------------- Pagos con Wompi (comercios.wompi.co → Desarrolladores)
# PAYMENTS_MODE=wompi  para pagos reales | demo  solo para pruebas locales (prohibido en producción)
PAYMENTS_MODE=wompi
WOMPI_ENV=sandbox                 # sandbox para pruebas, production para cobrar de verdad
WOMPI_PUBLIC_KEY=pub_test_xxxxxxxx
WOMPI_INTEGRITY_SECRET=test_integrity_xxxxxxxx
WOMPI_EVENTS_SECRET=test_events_xxxxxxxx

# Minutos que se apartan las fechas mientras el huésped paga
HOLD_MINUTES=30

# Cada cuántos minutos se leen los calendarios de Airbnb/Booking
ICAL_SYNC_MINUTES=15

# ---------------- Correo — OPCIONAL: lo normal es configurarlo en el panel (Ajustes → Correo).
# Estas variables solo se usan si en el panel no hay correo configurado.
# Ejemplo con Gmail: crea una "contraseña de aplicación" en tu cuenta de Google.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tucorreo@gmail.com
# SMTP_PASS=contraseña-de-aplicacion
# MAIL_FROM="Casas Campestres <tucorreo@gmail.com>"
# A dónde llegan los avisos de nuevas reservas y conflictos
# ADMIN_EMAIL=tucorreo@gmail.com

SITE_NAME=Casas Campestres
